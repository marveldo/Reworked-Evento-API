# Copy to .env and fill in. Never commit .env.
# Real environment variables (e.g. set on Render) override values in .env.

# ---- Server ----
PORT=10000                 # Render expects 10000; listen on 0.0.0.0
THREADS=4                  # Drogon IO threads
APP_ENV=development        # development | production
APP_HOST=127.0.0.1
FRONTEND_LINK=http://localhost:3000          # used for event_link and in emails
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://evento-frontend.vercel.app   # also checked on WebSockets; empty = any

# ---- Database (PostgreSQL) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=evento
DB_SCHEMA=public
DB_USER=postgres
DB_PASSWORD=
DB_CONNECTIONS=4           # connection pool size
# Or one URL instead of DB_HOST..DB_PASSWORD (encode special characters in the password, @ -> %40):
# DB_URL=postgresql://user:password@host:5432/dbname

# ---- Auth (JWT) ----
JWT_ACCESS_SECRET=         # two different long random strings
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=30d  # Django: ACCESS_TOKEN_LIFETIME = 30 days
JWT_REFRESH_EXPIRATION=90d # Django: REFRESH_TOKEN_LIFETIME = 90 days
GOOGLE_CLIENT_ID=          # same client id as the frontend's Google provider

#------EMAIL(RESEND)----
RESEND_API_KEY=
EMAIL_FROM=                # e.g. Evento <hello@yourdomain.com>
ASSETS_URL=                # optional: where evento-logo.png is hosted for emails

#------- Background Tasks --------
QUEUE_MAX_ATTEMPTS=5
QUEUE_MAX_IN_FLIGHT=100
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_USERNAME=            # only for a Redis ACL user other than "default"
REDIS_DB=0
# Or one URL instead of the REDIS_* fields above (must be redis://, not rediss://):
# REDIS_URL=redis://default:password@host:6379/0

#------ Location from the login IP -------
GEO_LOOKUP_ENABLED=true    # fills users.location as "<country>,<city>" (used by ?tag=Recommended)
IPINFO_TOKEN=              # optional ipinfo.io token for higher limits

#-----  Cloudinary (photos) -------
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER=evento   # photos go under evento/users/ and evento/events/

# ---- Migrations (golang-migrate) ----
# migrate -path migrations -database "$DATABASE_URL" up
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/evento?sslmode=disable
